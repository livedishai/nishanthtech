    .font-display { font-family: 'Sora', 'Inter', ui-sans-serif, sans-serif; }

    .glass-card {
      background: rgba(255, 255, 255, 0.04);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.08);
      transition: border-color .25s ease, box-shadow .25s ease, transform .25s ease;
    }
    .glass-card:hover {
      border-color: rgba(56, 189, 248, 0.4);
      box-shadow: 0 0 24px rgba(56, 189, 248, 0.15);
    }
    .lang-dropdown {
      background: rgba(15, 23, 42, 0.85);
      border: 1px solid rgba(56, 189, 248, 0.3);
    }
    .lang-dropdown:focus {
      outline: none;
      border-color: #38bdf8;
    }

    /* Signature element: an animated AR "scan line" used as section dividers and hero accents */
    .scan-divider {
      position: relative;
      height: 1px;
      width: 100%;
      background: linear-gradient(90deg, transparent, rgba(56,189,248,0.35), transparent);
      overflow: visible;
    }
    .scan-divider::after {
      content: "";
      position: absolute;
      top: -1px;
      left: 0;
      width: 120px;
      height: 3px;
      border-radius: 999px;
      background: linear-gradient(90deg, transparent, #38bdf8, #f0b93a, transparent);
      filter: blur(0.5px);
      box-shadow: 0 0 12px rgba(56,189,248,0.8);
      animation: scan-move 4.5s ease-in-out infinite;
    }
    @keyframes scan-move {
      0% { left: -10%; opacity: 0; }
      10% { opacity: 1; }
      50% { left: 100%; opacity: 1; }
      60% { opacity: 0; }
      100% { left: 100%; opacity: 0; }
    }

    .scan-frame { position: relative; }
    .scan-frame::before, .scan-frame::after {
      content: "";
      position: absolute;
      width: 22px; height: 22px;
      border: 2px solid rgba(56,189,248,0.6);
      z-index: 10;
    }
    .scan-frame::before { top: -1px; left: -1px; border-right: none; border-bottom: none; border-radius: 6px 0 0 0; }
    .scan-frame::after { bottom: -1px; right: -1px; border-left: none; border-top: none; border-radius: 0 0 6px 0; }

    details.faq-item summary::-webkit-details-marker { display: none; }
    details.faq-item[open] .chev { transform: rotate(180deg); }

    @media (prefers-reduced-motion: reduce) {
      .scan-divider::after { animation: none; left: 40%; opacity: 1; }
      * { scroll-behavior: auto !important; }
    }
  </style>
</head>
